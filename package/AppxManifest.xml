<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="SwanBridge.Vpn" Publisher="CN=SwanBridge Development"
            Version="0.1.0.49" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>SwanBridge VPN</DisplayName>
    <PublisherDisplayName>SwanBridge Community</PublisherDisplayName>
    <Description>Independent Windows VPN provider for strongSwan</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources><Resource Language="en-US" /><Resource Language="zh-Hans" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" MinVersion="14.0.33519.0" />
  </Dependencies>
  <Applications>
    <Application Id="App" Executable="SwanBridge.App.exe" EntryPoint="SwanBridge.App">
      <uap:VisualElements DisplayName="SwanBridge VPN" Description="SwanBridge VPN"
          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
          BackgroundColor="transparent" />
    </Application>
    <Application Id="Plugin">
      <uap:VisualElements DisplayName="SwanBridge VPN" Description="SwanBridge VPN"
          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
          BackgroundColor="transparent" AppListEntry="none" />
      <Extensions>
        <Extension Category="windows.backgroundTasks" Executable="SwanBridge.Host.exe" EntryPoint="SwanBridge.Plugin.BackgroundTask">
          <BackgroundTasks><uap:Task Type="vpnClient" /></BackgroundTasks>
        </Extension>
      </Extensions>
    </Application>
  </Applications>
  <Extensions>
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>SwanBridge.Plugin.dll</Path>
        <ActivatableClass ActivatableClassId="SwanBridge.Plugin.BackgroundTask" ThreadingModel="both" />
        <ActivatableClass ActivatableClassId="SwanBridge.Plugin.VpnPlugIn" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
  </Extensions>
  <Capabilities>
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="networkingVpnProvider" />
  </Capabilities>
</Package>
