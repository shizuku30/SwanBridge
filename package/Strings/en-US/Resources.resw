  <data name="UI_NewProfileReady" xml:space="preserve"><value>Enter the connection details. Advanced options use compatible defaults.</value></data>
  <data name="UI_DefaultsRestored" xml:space="preserve"><value>Advanced defaults restored. Identities and the key are unchanged. Save to apply.</value></data>
  <data name="UI_VisibilityFailed" xml:space="preserve"><value>Connections loaded, but some legacy profiles could not be made visible in Windows Settings.</value></data>
  <data name="UI_VisibilityDeferred" xml:space="preserve"><value>Active legacy profiles were not changed. Disconnect and refresh to update them.</value></data>
