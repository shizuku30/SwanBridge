  <data name="UI_ShowHelp" xml:space="preserve"><value>Show help</value></data>
  <data name="UI_HelpSuffix" xml:space="preserve"><value>: help</value></data>
  <data name="UI_InvalidChoice" xml:space="preserve"><value>Select a valid configuration value.</value></data>
