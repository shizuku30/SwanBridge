  <data name="UI_UnsavedBody" xml:space="preserve"><value>Switching connections or refreshing will discard the current edits.</value></data>
  <data name="UI_DiscardChanges" xml:space="preserve"><value>Discard changes</value></data>
  <data name="UI_KeepEditing" xml:space="preserve"><value>Keep editing</value></data>
  <data name="UI_NewPskHelp" xml:space="preserve"><value>A new connection requires a PSK. It is encrypted using data protection for the current Windows user.</value></data>
  <data name="UI_KeepPskHelp" xml:space="preserve"><value>Leave blank to retain the encrypted PSK. Enter a value only to replace it. Stored keys are never displayed.</value></data>
  <data name="UI_ReadOnlySuffix" xml:space="preserve"><value> - read-only; disconnect and refresh to edit</value></data>
  <data name="UI_UnsupportedProfile" xml:space="preserve"><value>This configuration format is unsupported. The connection was not modified. Check the version or manage it in Windows.</value></data>
